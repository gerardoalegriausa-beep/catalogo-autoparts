# Copia este archivo como .env.local (en tu computadora) o carga las mismas
# variables en Vercel → Settings → Environment Variables.

# --- Base de datos (Supabase → Project Settings → API) ---
# Sin estas dos variables la web funciona en MODO DEMOSTRACIÓN (piezas de
# ejemplo y pedidos en memoria que se borran al reiniciar).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de administración (/admin) ---
ADMIN_PASSWORD=
# Opcional: otra clave larga para firmar la sesión del panel.
ADMIN_SESSION_SECRET=

# --- Tienda ---
NEXT_PUBLIC_STORE_NAME=Repuestos Premium
# Tu WhatsApp para que los talleres te escriban (ej.: 51987654321)
NEXT_PUBLIC_CONTACT_WHATSAPP=

# --- Precios (USD). Valores por defecto entre paréntesis: SON SUPUESTOS ---
# Margen de la LLC sobre el costo del proveedor (15)
DEFAULT_MARGIN_PCT=15
# Tarifa del forwarder Miami → Lima por kg (8) y cobro mínimo por envío (25)
FREIGHT_USD_PER_KG=8
FREIGHT_MIN_USD=25
# Divisor del peso volumétrico aéreo: largo×ancho×alto (cm) / divisor (5000)
VOLUMETRIC_DIVISOR=5000
# Seguro sobre el valor del repuesto (1)
INSURANCE_PCT=1
# Arancel ad valorem en Perú por defecto (6); cada pieza puede tener el suyo
DEFAULT_DUTY_PCT=6
# IGV 16 % + IPM 2 % (18)
IGV_PCT=18
# Gestión de aduana y entrega por pedido (15)
HANDLING_USD=15
# Comisión de la pasarela de pago: Stripe con tarjeta internacional (4.4 % + 0.30)
PAYMENT_FEE_PCT=4.4
PAYMENT_FEE_FIXED_USD=0.3

# --- Días estimados por etapa (para la fecha prometida) ---
DAYS_VIN_CHECK=1
DAYS_PURCHASE=1
DAYS_TO_MIAMI=4
DAYS_MIAMI_TO_LIMA=4
DAYS_CUSTOMS_AND_DELIVERY=3
